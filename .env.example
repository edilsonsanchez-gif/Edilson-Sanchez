# Copie este arquivo para .env e preencha. O .env NÃO vai para o Git.

# Seu endereço do Gmail
EMAIL_USUARIO=seuemail@gmail.com

# Senha de app de 16 letras (NÃO é a senha normal do Gmail).
# Gere em https://myaccount.google.com/apppasswords (precisa da verificação em 2 etapas ativa).
EMAIL_SENHA_APP=

# Pastas a ler, separadas por vírgula. Ex.: INBOX,[Gmail]/Todos os e-mails
EMAIL_PASTAS=INBOX

# Na primeira busca, quantos dias para trás ler
EMAIL_DIAS_INICIAIS=30

# Porta do painel (http://localhost:8000)
PAINEL_PORTA=8000

# Opcional: servidor IMAP (padrão Gmail) e arquivo do banco local
# EMAIL_SERVIDOR_IMAP=imap.gmail.com
# PAINEL_BANCO=emails.db
